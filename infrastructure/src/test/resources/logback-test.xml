<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 项目自身代码 -->
    <logger name="com.example.agent" level="DEBUG"/>

    <!-- AgentScope SDK（包名 io.agentscope） -->
    <logger name="io.agentscope.harness.agent.middleware.AgentTraceMiddleware" level="DEBUG"/>

    <!-- 兜底：其余全部 DEBUG -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
